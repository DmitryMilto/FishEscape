  entries:
  - fishId: 'Tiger shark  '
    fishName: 
    fishType: 1
    oceanBackground: {fileID: 21300000, guid: e9f0823bdd18de2409f4ec2cb6a6c139, type: 3}
    gameFishSprite: {fileID: 21300000, guid: 68c52cbca50be6241901f6249ae2e944, type: 3}
    realFishSprite: {fileID: 21300000, guid: 94411bd3bf643944687943d7b546e56a, type: 3}
    description: "The tiger shark gets its name from the characteristic vertical
      bars that cover the sides of its body.\_Reaching lengths of at least 18 feet
      (5.5 m) and 2000 pounds (nearly a metric tonne).\r\n\r\nTiger sharks are known
      for eating almost anything, including other sharks, fish, seabirds, dolphins,
      sea turtles, rays and crustaceans.1\_They have also been found with many non-food
      items in their stomachs, including metal objects, plastics, burlap sacks and
      other refuse.\r\n"
    ocean: 1
    initialState: 1
  - fishId: Palette surgeonfish
    fishName: 
    fishType: 0
    oceanBackground: {fileID: 21300000, guid: e9f0823bdd18de2409f4ec2cb6a6c139, type: 3}
    gameFishSprite: {fileID: 21300000, guid: f8e433f0d267ed64094a8fb8c1b4ef36, type: 3}
    realFishSprite: {fileID: 21300000, guid: 9e5b0185af5c7774f80eb33ed3175eed, type: 3}
    description: "Palette surgeonfish\_live around tropical coral reefs with strong
      water currents. This species has an oval-shaped, laterally compressed body
      with a pointed snout-like nose and small mouth.\r\n\r\nSurgeonfishes are mostly
      algae eaters. They develop from a transparent larva (acronurus) and, with growth,
      may change considerably in form or colour"
    ocean: 1
    initialState: 1
